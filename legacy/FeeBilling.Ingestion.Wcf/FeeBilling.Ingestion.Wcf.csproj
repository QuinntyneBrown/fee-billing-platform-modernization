<Project Sdk="Microsoft.NET.Sdk">

  <!-- WCF service application (CustodianFeedService.svc), hosted in IIS. Compiles only; see legacy/README.md. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FeeBilling.Ingestion.Wcf</RootNamespace>
    <AssemblyName>FeeBilling.Ingestion.Wcf</AssemblyName>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
    <PackageReference Include="log4net" Version="2.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceModel.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeeBilling.Data\FeeBilling.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CustodianFeedService.svc" />
    <Content Include="Web.config" />
  </ItemGroup>

</Project>
