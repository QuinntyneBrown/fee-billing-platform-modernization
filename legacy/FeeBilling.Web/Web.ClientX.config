<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated instance for ClientX (enterprise client, single-tenant, on their own SQL Server).
  Applied on top of Web.Release.config by the deployment script.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="FeeBillingEntities"
         connectionString="metadata=res://*/FeeBilling.csdl|res://*/FeeBilling.ssdl|res://*/FeeBilling.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=CLIENTX-SQL02\BILLING;initial catalog=FeeBilling_ClientX;user id=fb_clientx;password=ClientX#Billing7;MultipleActiveResultSets=True;App=EntityFramework&quot;"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    <add name="FeeBillingAdo"
         connectionString="Data Source=CLIENTX-SQL02\BILLING;Initial Catalog=FeeBilling_ClientX;User Id=fb_clientx;Password=ClientX#Billing7"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    <add name="FeeBillingReporting"
         connectionString="Data Source=CLIENTX-SQL02\BILLING;Initial Catalog=FeeBillingReporting_ClientX;User Id=fb_clientx;Password=ClientX#Billing7"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <!-- ClientX's fee agreement says actual/365. See Billing.DayCountBasis in Web.config: nothing reads it. -->
    <add key="Billing.DayCountBasis" value="Actual/365" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Feature.HouseholdBilling" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Invoice.LogoPath" value="D:\ClientX\branding\clientx-logo.png" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Smtp.From" value="billing@clientx.example" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <machineKey validationKey="1F2E3D4C5B6A79880F1E2D3C4B5A69788F9E0D1C2B3A49586F7E8D9C0B1A29384F5E6D7C8B9A0F1E2D3C4B5A69788F9E0D1C2B3A49586F7E8D9C0B1A29384F5E"
                decryptionKey="0F1E2D3C4B5A69788796A5B4C3D2E1F00F1E2D3C4B5A69788796A5B4C3D2E1F0"
                xdt:Transform="SetAttributes" />
  </system.web>
</configuration>
