* text=auto

# Shell scripts run inside Linux containers
*.sh text eol=lf

# Custodian files are byte-exact test fixtures (Windows-1252, CRLF). Never normalize.
seed/custodian-files/** binary

# Instructional audio lessons are stored in Git LFS.
docs/instructional/**/*.mp3 filter=lfs diff=lfs merge=lfs -text

# Instructional lesson videos are stored in Git LFS.
docs/instructional/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
